    },
    {
      "parameters": {
        "values": {
          "string": [
            {
              "name": "message",
              "value": "User has many repos!"
            }
          ]
        }
      },
      "id": "set-high",
      "name": "Set High Message",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.2,
      "position": [850, 200]
    },
    {
      "parameters": {
        "values": {
          "string": [
            {
              "name": "message",
              "value": "User has few repos"
